# Example environment file for HotWaterGas_FE.
#
# Copy this file to ".env.local" and fill in the values for your machine:
#
#   cp .env.example .env.local
#
# ".env.local" is git-ignored, so your local values are never committed.
# ".env.example" IS committed, so it must only ever contain placeholders.

# Base URL of the ASP.NET Core backend.
#
# - Must be an absolute URL (the Google OAuth flow does a full-page
#   redirect to it).
# - Must NOT end with "/api". The frontend's API calls already include
#   their own "/api/..." prefix, so a trailing "/api" would result in
#   duplicated "/api/api/..." routes.
#
# Local development (the backend's "https" launch profile):
VITE_API_BASE_URL=https://localhost:7140

# Production placeholder — replace with your deployed backend URL.
# VITE_API_BASE_URL=https://your-backend-domain.example.com
